      <aliases enabled='yes' />
      <column caption='Carrier Name' datatype='string' name='[CARRIER_NAME]' role='dimension' type='nominal' />
      <column caption='DATE' datatype='date' name='[Calculation_903534683646496768]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(STR([YEAR]) + &quot;-&quot; + STR([MONTH]) + &quot;-01&quot;)' />
      </column>
      <column caption='Color_Threshold' datatype='boolean' name='[Calculation_903534683647365122]' role='measure' type='nominal'>
        <calculation class='tableau' formula='RUNNING_SUM(SUM([PASSENGERS]))/TOTAL(SUM([PASSENGERS])) &gt;= [Parameters].[Parameter 1]'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Rank' datatype='integer' name='[Calculation_903534683648077827]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='RANK(SUM([PASSENGERS]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Orig_Dest_City' datatype='string' name='[Calculation_903534683649957894]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [ORIGIN_CITY_NAME] &lt;= [DEST_CITY_NAME]&#13;&#10;THEN STR([ORIGIN_CITY_NAME]) + &quot; &amp; &quot;  + STR([DEST_CITY_NAME])&#13;&#10;ELSE STR([DEST_CITY_NAME]) + &quot; &amp; &quot;  + STR([ORIGIN_CITY_NAME])&#13;&#10;END' />
      </column>
      <column caption='Airports_count' datatype='integer' name='[Calculation_903534683651682313]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([ORIGIN_AIRPORT_ID])' />
      </column>
      <column caption='Airlines_count' datatype='integer' name='[Calculation_903534683651751946]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([CARRIER_NAME])' />
      </column>
      <column caption='Seasons' datatype='string' name='[Calculation_903534683661553679]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [MONTH] IN (3,4,5) THEN &quot;Spring&quot;&#13;&#10;ELSEIF [MONTH] IN (6,7,8) THEN &quot;Summer&quot;&#13;&#10;ELSEIF [MONTH] IN (9,10,11) THEN &quot;Autumn&quot;&#13;&#10;ELSEIF [MONTH] IN (12,1,2) THEN &quot;Winter&quot;&#13;&#10;END' />
      </column>
      <column caption='Categorical_Features' datatype='string' name='[Calculation_903534683666583574]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = &quot;Airlines&quot; THEN [CARRIER_NAME]&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &quot;Distance Group&quot; THEN [DISTANCE_GROUP]&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &quot;State&quot; THEN [ORIGIN_STATE_NM]&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &quot;City&quot; THEN [ORIGIN_CITY_NAME]&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &quot;Popular Routes&quot; THEN [Calculation_903534683649957894]&#13;&#10;END' />
      </column>
      <column aggregation='Sum' caption='Filter_Route/DG' datatype='integer' name='[Calculation_903534683670814744]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = &quot;Popular Routes&quot;&#13;&#10;    OR [Parameters].[Parameter 2] = &quot;Distance Group&quot;&#13;&#10;    THEN 1&#13;&#10;&#13;&#10;ELSE 0&#13;&#10;&#13;&#10;END' />
      </column>
      <column aggregation='Sum' caption='Filter_Airlines' datatype='integer' name='[Calculation_903534683679432731]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = &quot;Airlines&quot; THEN 1 ELSE 0 END' />
      </column>
      <column caption='Cumulative_Passenger_pct' datatype='real' name='[Calculation_903534683685728285]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RUNNING_SUM(SUM([PASSENGERS]))/TOTAL(SUM([PASSENGERS]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Dest City Name' datatype='string' name='[DEST_CITY_NAME]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
      <column caption='Distance' datatype='real' name='[DISTANCE]' role='measure' type='quantitative' />
