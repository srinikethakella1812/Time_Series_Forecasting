              <calculation class='tableau' formula='IF [ORIGIN_CITY_NAME] &lt;= [DEST_CITY_NAME]&#13;&#10;THEN STR([ORIGIN_CITY_NAME]) + &quot; &amp; &quot;  + STR([DEST_CITY_NAME])&#13;&#10;ELSE STR([DEST_CITY_NAME]) + &quot; &amp; &quot;  + STR([ORIGIN_CITY_NAME])&#13;&#10;END' />
